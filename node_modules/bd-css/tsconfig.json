{
	"compilerOptions": {
		"target": "esnext",
		"module": "nodenext",
		"types": ["bun"],

		"rootDir": "./src",
		"outDir": "./lib",

		"declaration": true,
		"declarationMap": true,

		"moduleResolution": "nodenext",
		"verbatimModuleSyntax": true,

		"skipLibCheck": true,
		"noFallthroughCasesInSwitch": true
	},
	"include": ["src"],
	"exclude": ["node_modules", "lib"]
}
